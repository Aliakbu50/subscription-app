# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — these hold Supabase keys. NEVER commit them.
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
# ...but the placeholder template IS committed, so new machines know what to fill in.
!.env.example

# certificates and signing material (Apple Wallet .p12, WWDR, etc.)
# these live base64-encoded in env vars, never as files in the repo
*.p12
*.cer
*.key
*.mobileprovision

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
